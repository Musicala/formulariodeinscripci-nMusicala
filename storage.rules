rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /fotos-estudiantes/{fileName} {
      // Solo permite subir imágenes JPG, PNG o WEBP de máximo 3 MB
      allow write: if request.resource.size <= 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Solo lectura pública (para poder mostrar la foto después)
      allow read: if true;
    }
    // Bloquea cualquier otra ruta
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}