rules_version = '2';

// Reglas de estudiantes-musicala (Formulario v2 / Lista de Estudiantes).
//
// Principios:
// - El formulario público SOLO puede CREAR inscripciones nuevas.
//   No puede leer, listar, actualizar ni eliminar. Los reintentos del
//   formulario no reescriben Firestore (flag firestoreSaved en app.js).
// - studentId debe ser igual al ID del documento en la creación.
// - El documento de identidad (studentDocument) nunca queda expuesto a
//   lecturas públicas. El índice privado student_document_index solo lo
//   maneja el backend (Admin SDK).
// - El personal autorizado (allowlist) mantiene acceso administrativo.
//
// IMPORTANTE (orden de despliegue): estas reglas cierran la lectura pública.
// El importador Wix de RIP dejará de poder leer `estudiantes` directamente
// desde el navegador; primero debe estar desplegada y backfilleada la
// sincronización Lista → RIP (rip-musicala/students). Ver DEPLOYMENT.md.

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          "catalina.medina.leal@gmail.com",
          "alekcaballeromusic@gmail.com",
          "imusicala@gmail.com",
          "musicalaasesor@gmail.com",
          "adminmusicala@gmail.com"
        ];
    }

    match /estudiantes/{studentId} {
      // Personal: lectura y escritura administrativas completas.
      allow read, update, delete: if isStaff();

      // Formulario público: SOLO creación de la inscripción, una vez.
      // El studentId del contenido debe coincidir con la ruta.
      allow create: if isStaff() || (
        request.resource.data.studentId == studentId &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() > 0 &&
        request.resource.data.studentName.size() < 200
      );
    }

    // Índice privado de huellas de documento (HMAC calculado por backend).
    // Nunca accesible desde clientes, ni siquiera del personal: se consulta
    // exclusivamente via Admin SDK.
    match /student_document_index/{fingerprint} {
      allow read, write: if false;
    }

    // Todo lo demás: solo personal autorizado.
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
